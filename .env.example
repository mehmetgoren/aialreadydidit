# Copy to .env and adjust. `docker compose up --build` reads it automatically.

# Where the LLM-generated projects for the demo seed live on the host (mounted read-only at /seed).
LLM_PROJECTS_PATH=./seed-projects
# Production only: publish CPU-Z / HWMonitor from LLM_PROJECTS_PATH under the admin account (no demo member). Idempotent.
SEED_PUBLISH_SAMPLE_APPS=false

# Public origins (what browsers / agents use). Change for a real domain.
SITE_PUBLIC_URL=http://localhost:9002
API_PUBLIC_URL=http://localhost:5190
MCP_PUBLIC_URL=http://localhost:5191/mcp
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Secrets — CHANGE IN PRODUCTION
JWT_KEY=CHANGE_ME_p0G5uW2kQ9xT4rL8bN1cV6mZ3yH7jE0aS5dF2gK9hJ4lP1oI8uY3tR6eW
POSTGRES_PASSWORD=1234
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
ADMIN_EMAIL=admin@example.com
# Contact address shown on the site / in e-mails
SUPPORT_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=Aadi123!

# Google Sign-In (web client id). Leave empty to hide the button.
GOOGLE_CLIENT_ID=

# Outgoing e-mail (verification, password reset, notifications). Console = only written to the API log.
# Smtp: EMAIL_SMTP_PORT 587 + EMAIL_SMTP_SSL=false (STARTTLS) or 465 + EMAIL_SMTP_SSL=true (implicit TLS).
EMAIL_PROVIDER=Console
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=AI Already Did It
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SSL=false

# AI provider: Ollama (container below) | OpenAi (any OpenAI-compatible API) | None
AI_PROVIDER=Ollama
AI_EMBEDDING_PROVIDER=
AI_CHAT_PROVIDER=
# LLM-assisted categorisation in the upload wizard / moderation queue. Needs a chat model (GPU or paid API) -> off by default;
# when off, uploaders must pick the category and sub-category themselves.
AI_CATEGORY_SUGGESTIONS=false
# Ollama container: models pulled at first start (space separated). qwen3.8 is ~17 GB; drop it to keep only embeddings.
OLLAMA_PULL_MODELS=bge-m3 qwen3.8:latest
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen3.8:latest
OLLAMA_EMBEDDING_MODEL=bge-m3
# OpenAI-compatible (production)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional GitHub token for repository imports (raises the API quota)
GITHUB_TOKEN=

# ASPNETCORE_ENVIRONMENT=Development seeds the demo member + the two demo apps on first start
ASPNETCORE_ENVIRONMENT=Development
