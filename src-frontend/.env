# Shown in the header / document title
VITE_APP_TITLE=AI Already Did It

# Absolute API root used by axios (LocalService may override it at runtime via localStorage "aadi_server_address").
VITE_API_BASE_URL=http://localhost:5190/api/v1

# Where the Vite dev server proxies "/api" requests when VITE_API_BASE_URL is relative
VITE_API_PROXY_TARGET=http://localhost:5190
